{
  "name": "player-online",
  "version": "0.1.0",
  "private": true,
  "description": "Player Online: play video and music in the browser, with a launcher that routes files to the right player (video, music, games, documents). Installable PWA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-pages.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "pages": "node scripts/build-pages.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dashjs": "^5.2.1",
    "hls.js": "^1.7.3",
    "libavjs-webcodecs-bridge": "^0.3.2"
  }
}
